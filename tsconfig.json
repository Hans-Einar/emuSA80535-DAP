{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": ".",
    "outDir": "out",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node",
      "vscode"
    ],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true
  },
  "include": [
    "adapter/src/**/*.ts",
    "extension/src/**/*.ts",
    "test/**/*.ts"
  ]
}
